              },
              "amountMinor": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 === 0"
              },
              "guests": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && newData.val() % 1 === 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "expenses": {
            ".validate": "newData.hasChildren()",
            "$expenseKey": {
              ".validate": "newData.hasChildren(['id','title','date','amountMinor','currency','splitCount'])",
              "id": {
                ".validate": "newData.isString() && newData.val() === $expenseKey && newData.val().length > 0 && newData.val().length <= 100"
              },
              "title": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && newData.val().matches(/.*[^ ].*/)"
              },
              "date": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.val() >= newData.parent().parent().parent().child('startDate').val() && newData.val() <= newData.parent().parent().parent().child('endDate').val()"
              },
              "groupId": {
                ".validate": "newData.isString() && newData.val().length <= 100 && (newData.val() === '' || newData.parent().parent().parent().child('groups').child(newData.val()).exists())"
              },
              "amountMinor": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && newData.val() % 1 === 0"
              },
              "currency": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3}$/)"
              },
              "notes": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              },
              "category": {
                ".validate": "newData.isString() && newData.val().length <= 50"
              },
              "payer": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "splitCount": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && newData.val() % 1 === 0"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
